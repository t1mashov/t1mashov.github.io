# Один из способов разместить это на своём сервере — необязательно nginx, можно
# и любой статический хостинг. Если у вас уже есть коробка HDE со своим nginx:
# добавить внутрь существующего server { ... } для её домена (обычно
# /var/www/hde.conf/nginx.conf), рядом с остальными location.
#
# alias указывает прямо на склонированный репозиторий (git clone <repo>
# /var/www/hde.push) — отдельного шага сборки нет, страница читает config.json
# из той же папки сама через fetch().
#
# ^~ обязателен: без него запрос может уйти в location с регулярным выражением,
# который у коробки обычно роутит всё через PHP-приложение — а тут нужна просто
# статика в обход HDE-роутинга.

location ^~ /push/ {
    alias /var/www/hde.push/;
    index index.html;
    try_files $uri $uri/ =404;
}
